{
  "_comment": "Logbook generator config. Run build.py after editing to regenerate the HTML and Apps Script.",

  "experiment_name": "PionCT",
  "page_title": "PionCT Logbook Entry Generator",
  "contact_email": "gayoso@jlab.org",
  "credit_line": "Original idea from Andrew Schick for the PRadII experiment",

  "logo": {
    "path": "logo00.png",
    "alt": "PionCT Logo"
  },

  "quick_links": [
    { "label": "Short Term Run Plan",                       "id": "runPlanLink"    },
    { "label": "Link to pionCT Shift Worker's Checklist",   "id": "checklistLink"  },
    { "label": "Link to Beamtime Accounting",               "id": "beamtimeLink"   }
  ],

  "google_sheets": {
    "enabled": true,
    "sheet_name": "Run Log",
    "shared_secret": "CHANGE_ME_TO_SOMETHING_PRIVATE"
  },

  "shift_header": [
    {
      "id":      "shiftType",
      "label":   "Shift",
      "type":    "select",
      "options": ["Owl", "Day", "Swing"],
      "default": "Owl"
    },
    {
      "id":      "shiftDate",
      "label":   "Shift Date",
      "type":    "date-now",
      "placeholder": "DD-Month-YYYY",
      "_comment": "Has a 'Set Date' button that disables after first use."
    },
    {
      "id":    "shiftLeader",
      "label": "Shift Leader",
      "type":  "text"
    },
    {
      "id":    "targetOperator",
      "label": "Target Operator",
      "type":  "text"
    }
  ],

  "run_fields": [
    {
      "key":          "run-number",
      "label":        "Run Number",
      "type":         "text",
      "source":       "user",
      "sheet_column": "Run Number",
      "sheet_align":  "right",
      "js_key":       "runNumber",
      "_comment":     "js_key override: this field keeps the 'run' prefix, unlike other fields."
    },
    {
      "key":          "date",
      "label":        "Date",
      "type":         "text",
      "source":       "auto",
      "sheet_column": "Date",
      "sheet_align":  "center",
      "_comment":     "Auto-filled as YYYY-MM-DD at generate/send time. Not shown in the form."
    },
    {
      "key":          "run-start",
      "label":        "Start Time",
      "type":         "text",
      "source":       "user",
      "placeholder":  "00:00",
      "sheet_column": "Start Time",
      "sheet_align":  "right",
      "js_key":       "startTime",
      "_comment":     "js_key override: payload name doesn't mechanically derive from the CSS class."
    },
    {
      "key":          "run-stop",
      "label":        "Stop Time",
      "type":         "text",
      "source":       "user",
      "placeholder":  "00:00",
      "sheet_column": "End Time",
      "sheet_align":  "right",
      "js_key":       "stopTime",
      "_comment":     "js_key override: payload name doesn't mechanically derive from the CSS class."
    },
    {
      "key":          "run-length",
      "label":        "Total Time (min)",
      "type":         "text",
      "source":       "auto",
      "sheet_column": "Total Time",
      "sheet_align":  "right",
      "js_key":       "totalTime",
      "_comment":     "Auto-calculated as Stop - Start. Shown read-only in the form. js_key override: payload name doesn't mechanically derive from the CSS class."
    },
    {
      "key":          "run-target",
      "label":        "Target",
      "type":         "text",
      "source":       "user",
      "sheet_column": "Target",
      "sheet_align":  "left"
    },
    {
      "key":          "run-current",
      "label":        "Beam Current (uA)",
      "type":         "text",
      "source":       "user",
      "sheet_column": "Beam Current (uA)",
      "sheet_align":  "right"
    },
    {
      "key":          "run-hms-p",
      "label":        "HMS P [GeV]",
      "type":         "text",
      "source":       "user",
      "sheet_column": "HMS P [GeV]",
      "sheet_align":  "right"
    },
    {
      "key":          "run-shms-p",
      "label":        "SHMS P [GeV]",
      "type":         "text",
      "source":       "user",
      "sheet_column": "SHMS P [GeV]",
      "sheet_align":  "right"
    },
    {
      "key":          "run-hms-angle",
      "label":        "HMS Angle [deg]",
      "type":         "text",
      "source":       "user",
      "sheet_column": "HMS angle [deg]",
      "sheet_align":  "right"
    },
    {
      "key":          "run-shms-angle",
      "label":        "SHMS Angle [deg]",
      "type":         "text",
      "source":       "user",
      "sheet_column": "SHMS angle [deg]",
      "sheet_align":  "right"
    },
    {
      "key":          "run-hms-eff",
      "label":        "HMS track efficiency",
      "type":         "text",
      "source":       "user",
      "sheet_column": "HMS track eff",
      "sheet_align":  "right"
    },
    {
      "key":          "run-shms-eff",
      "label":        "SHMS track efficiency",
      "type":         "text",
      "source":       "user",
      "sheet_column": "SHMS track eff",
      "sheet_align":  "right"
    },
    {
      "key":          "run-hms-34",
      "label":        "HMS 3/4 efficiency",
      "type":         "text",
      "source":       "user",
      "sheet_column": "HMS 3/4 eff",
      "sheet_align":  "right"
    },
    {
      "key":          "run-shms-34",
      "label":        "SHMS 3/4 efficiency",
      "type":         "text",
      "source":       "user",
      "sheet_column": "SHMS 3/4 eff",
      "sheet_align":  "right"
    },
   {
      "key":          "run-events",
      "label":        "Number of Events (M)",
      "type":         "text",
      "source":       "user",
      "sheet_column": "Number of Events (M)",
      "sheet_align":  "right"
    },
    {
      "key":          "run-trigger-rate",
      "label":        "Trigger Rate [Hz]",
      "type":         "text",
      "source":       "user",
      "sheet_column": "Trigger Rate [Hz]",
      "sheet_align":  "right"
    },
     {
      "key":          "prescales",
      "label":        "Prescales Enabled",
      "type":         "text",
      "source":       "user",
      "sheet_column": "Prescales Enabled",
      "sheet_align":  "left"
    },
    {
      "key":          "run-comments",
      "label":        "Comments",
      "type":         "textarea",
      "source":       "user",
      "sheet_column": "Comments",
      "sheet_align":  "left"
    },
    {
      "key":          "run-good-flag",
      "label":        "50k ok?",
      "type":         "checkbox",
      "source":       "user",
      "sheet_column": "50k OK?",
      "sheet_align":  "center"
    },
    {
      "key":          "run-production",
      "label":        "Production?",
      "type":         "checkbox",
      "source":       "user",
      "sheet_column": "Production?",
      "sheet_align":  "center"
    }
  ]
}
